nextflow_process {

    name "Test Process TRANSLATE_LOCI_OF_INTEREST"
    script "modules/local/translate_loci_of_interest.nf"
    process "TRANSLATE_LOCI_OF_INTEREST"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/input/allele_table.tsv")
                input[1] = file("${projectDir}/tests/input/panel_info.bed")
                input[2] = file("${projectDir}/tests/input/loci_of_interest.bed")
                input[3] = ""
                """
            }
        }

        then {
            assert process.success
            // channel exists
            assert process.out.collapsed_amino_acid_calls != null
            // output md5 check
            assert path(process.out.collapsed_amino_acid_calls.get(0)).md5 == "cd9cf4a6aa1ad66c99816239abf3a532"
            assert path(process.out.amino_acid_calls.get(0)).md5 == "545f952c39c8206625359cd613b1f29c"
            assert path(process.out.loci_covered_by_target_samples_info.get(0)).md5 == "1b2c20818014cb785d013fc21ff46346"
            assert path(process.out.loci_of_interest_for_target_for_microhap.get(0)).md5 == "2b9323b36ae6979db24b6456eac732ea"

        }

    }

}
