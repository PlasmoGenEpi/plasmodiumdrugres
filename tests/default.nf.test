// Pipeline-test when.params are written to a JSON file before Nextflow loads config,
// so params.pipelines_testdata_base_path is not available here (becomes "null" + path).
// Keep in sync with nextflow.config / tests/nextflow.config / nextflow_schema.json.
def pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/plasmodiumdrugres/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // Inputs from conf/test.config via nf-test.config profile "test".
    // Run with --profile=+docker (or +conda / +singularity).
    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // removeNextflowVersion("$outputDir/pipeline_info/nf_core_plasmodiumdrugres_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    // Same file is fine; nf-test 0.9.x only allows `profile` on the suite, not per test().
    // Global profile "test" still sets allele_table, so PMO inputs must be set here and
    // allele-table params cleared (mirrors conf/test_pmo.config).
    test("-profile test_pmo") {

        when {
            params {
                outdir                = "$outputDir"
                pmo                   = pipelines_testdata_base_path + 'testdata/example_PMO.json'
                allele_table          = null
                panel_info_bed        = null
                pmo_population_fields = "collection_country"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // removeNextflowVersion("$outputDir/pipeline_info/nf_core_plasmodiumdrugres_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }
}
