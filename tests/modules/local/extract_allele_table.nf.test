nextflow_process {

    name "Test Process EXTRACT_ALLELE_TABLE"
    script "modules/local/extract_allele_table.nf"
    process "EXTRACT_ALLELE_TABLE"

    test("Should extract allele table without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'testdata/example_PMO.json', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert process.out.allele_table != null
            assert path(process.out.allele_table.get(0)).md5 == "475740242a34d65043ce86745ba07f78"
        }

    }

}
