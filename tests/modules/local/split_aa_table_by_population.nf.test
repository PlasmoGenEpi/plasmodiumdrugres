nextflow_process {

    name "Test Process SPLIT_AA_TABLE_BY_POP"
    script "modules/local/split_aa_table_by_population.nf"
    process "SPLIT_AA_TABLE_BY_POP"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/input/amino_acid_calls.tsv")
                input[1] = file("${projectDir}/tests/input/population_assignment_indexed.tsv")
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.per_pop_tables.get(0)[0]).md5 == "e2f0fab0d8a9b88d32bfd1bd9d9f4648"
            assert path(process.out.per_pop_tables.get(0)[1]).md5 == "9d66f68ef70dcf63f092277c69cb4f9b"
        }

    }

}
