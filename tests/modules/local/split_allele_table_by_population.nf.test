nextflow_process {

    name "Test Process SPLIT_ALLELE_TABLE_BY_POP"
    script "modules/local/split_allele_table_by_population/main.nf"
    process "SPLIT_ALLELE_TABLE_BY_POP"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/input/allele_table.tsv")
                input[1] = file("${projectDir}/tests/input/population_assignment_indexed.tsv")
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.per_pop_tables.get(0)[0]).md5 == "b32c48e492b19eca30f36893b2c0963e"
            assert path(process.out.per_pop_tables.get(0)[1]).md5 == "0964d377bdef4edd0c8fef9e226d160e"
            assert path(process.out.per_pop_tables.get(0)[2]).md5 == "a0bd92fbdb98f240e45e237386152086"
        }

    }

}
