nextflow_process {

    name "Test Process MERGE_TABLES"
    script "modules/local/merge_tables/main.nf"
    process "MERGE_TABLES"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = tuple('pop1', [
                file("${projectDir}/tests/input/allele_prev.tsv"),
                file("${projectDir}/tests/input/aa_mlaf.tsv"),
                file("${projectDir}/tests/input/aa_slaf.tsv"),
                file("${projectDir}/tests/input/sl_from_ml.tsv")])
                input[1] = file("${projectDir}/tests/input/empty_population_index_lookup.tsv")
                """
            }
        }

        then {
            assert process.success

            // channel exists
            assert process.out.sl_summary != null
            assert process.out.ml_summary != null
            assert process.out.sl_from_ml_summary != null

            // output md5 check
            assert path(process.out.sl_summary.get(0)).md5 == "28bca06f0b8b9f3561eb407fd02764af"
            assert path(process.out.ml_summary.get(0)).md5 == "cd4642adbd28904af2103bcca15660dc"
            assert path(process.out.sl_from_ml_summary.get(0)).md5 == "ef3b5a5e93d31e498c61462f6fe443f8"

        }

    }

    test("Should restore true population labels from index lookup") {

        when {
            process {
                """
                input[0] = tuple('popidx_001', [
                file("${projectDir}/tests/input/allele_prev.tsv"),
                file("${projectDir}/tests/input/aa_mlaf.tsv"),
                file("${projectDir}/tests/input/aa_slaf.tsv"),
                file("${projectDir}/tests/input/sl_from_ml.tsv")])
                input[1] = file("${projectDir}/tests/input/population_index_lookup.tsv")
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.sl_summary.get(0)).text.contains("Vietnam_201801-01")
            assert path(process.out.ml_summary.get(0)).text.contains("Vietnam_201801-01")
            assert path(process.out.sl_from_ml_summary.get(0)).text.contains("Vietnam_201801-01")
        }

    }

}
