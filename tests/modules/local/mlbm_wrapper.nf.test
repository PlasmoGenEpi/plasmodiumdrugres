nextflow_process {

    name "Test Process MLBM_WRAPPER"
    script "modules/local/mlbm_wrapper.nf"
    process "MLBM_WRAPPER"

    test("Test for failures and output file checksums") {

        when {
            process {
                """
                input[0] = file("${projectDir}/tests/input/amino_acid_calls.tsv")
                input[1] = file("${projectDir}/tests/input/loci_groups.tsv")
                """
            }
        }

        then {
            assert process.success
            assert process.out.mlaf != null
            // unpack tuple output
            def (pop, outFile) = process.out.mlaf.get(0)

            assert pop == 'amino_acid_calls'

            // output md5 check
            assert path(outFile).md5 == "ae1322b7fb6d48bb428247d47d47541a"
        }

    }

}
